# Build output
target/

# Project-local Maven repository. Present because ~/.m2 is not writable in the
# development sandbox this was authored in; CI uses the standard ~/.m2.
.m2repo/

# Local Maven settings holding the Central Portal token. Never commit this: it is a
# publishing credential for the whole namespace. The canonical location is
# ~/.m2/settings.xml; this path exists only because ~/.m2 is not writable here.
.m2settings/

# H2 files written by the demo at runtime
data/
*.mv.db
*.trace.db

# Keystore generated by scripts/make-keystore.sh. Never commit one: the demo
# generates a localhost self-signed certificate, and a checked-in key is a
# checked-in key.
*.p12
*.jks
*.keystore

# Python
__pycache__/
*.py[cod]
.venv/

# Editors / OS
.idea/
*.iml
.vscode/
.DS_Store
