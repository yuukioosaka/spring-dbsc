<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>click.yukio.dbsc</groupId>
  <artifactId>spring-dbsc</artifactId>
  <version>0.6.1</version>
  <name>spring-dbsc</name>
  <description>Embeddable Spring Boot implementation of Device Bound Session Credentials (DBSC Toolkit Protocol 1.0)</description>
  <url>https://github.com/yuukioosaka/spring-dbsc</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>yuukioosaka</id>
      <url>https://github.com/yuukioosaka</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/yuukioosaka/spring-dbsc.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/yuukioosaka/spring-dbsc.git</developerConnection>
    <url>https://github.com/yuukioosaka/spring-dbsc</url>
  </scm>

  <!--
    The library JAR is what consumers depend on. Packaging is left at the default
    "jar"; the Spring Boot repackage goal is deliberately off, since there is no
    main class to make executable and the plain JAR is what a host app wants on
    its classpath.

    src/demo is an OPT-IN sample app (form login over HTTPS) used for manual
    browser testing. It is not part of the library: run it with -Pdemo.
  -->

  <properties>
    <!--
      Built for Java 17, the lowest JDK Spring Boot 3.5 supports. Compiling at
      the Java 17 release level rather than 25 is a distribution choice: the class
      files then load on JDK 17 and every later JDK, so the library is usable by
      adopters on 17, 21 and 25 alike instead of 25+ only.

      The source deliberately stays inside the Java 17 language level. That rules
      out switch pattern matching (case String s ->, case null ->), which is 21+;
      the JSON codec in core.Json uses if/else chains where it would otherwise be
      the natural style.
    -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <maven-gpg-plugin.version>3.2.7</maven-gpg-plugin.version>
    <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>

    <!--
      Read by central-publishing-maven-plugin. False means "upload, validate, then
      stop for manual approval", which is the safe default given that a Central
      release is irreversible. Overridden with -Dcentral.autoPublish=true.
    -->
    <central.autoPublish>false</central.autoPublish>

    <!--
      Extra Spring profiles the demo app activates, appended to "demo". The demo
      profile's active profiles are a command-line argument, and a command-line
      argument wins over -Dspring-boot.run.jvmArguments, so this property is the
      only working place to add one.
    -->
    <dbsc.demo.profiles></dbsc.demo.profiles>

    <!--
      Pins Netty past the versions Spring Boot 3.5.x manages.

      Netty is not a direct dependency: it arrives transitively with Lettuce, which
      is itself optional and only used by dbsc.storage=redis. So this pin reaches
      only adopters who opted into the Redis adapter, and the default JDBC/memory
      builds are unaffected either way.

      The pin is needed because Boot 3.5.16 still ships Netty 4.1.135 via Lettuce
      6.6.x, while the advisories against netty-handler and netty-codec are fixed
      only in 4.1.137+. Overriding the BOM property here rather than excluding and
      re-declaring keeps every Netty artifact on one version; a mixed set is worse
      than a slightly stale one.

      Remove this once a Boot release manages 4.1.137 or later on its own, which is
      the point at which the pin stops being a fix and starts being a liability.
    -->
    <netty.version>4.1.138.Final</netty.version>

    <!--
      Three more overrides, same reasoning as netty.version above, and the same
      exit condition: delete each once a Boot release manages the fixed version
      on its own.

      Boot 3.5.16 manages Tomcat 10.1.55, jackson-bom 2.21.4 and log4j2 2.24.3,
      each exactly one patch behind the version its open advisories ask for. All
      three versions are published, and all three properties are the ones Boot's
      own BOM reads, so nothing else has to change.

      These are different in kind from the Netty pin: Tomcat is the servlet
      container this library's filters actually run inside, and Jackson is what
      serialises the protocol's JSON. A patch bump within the same minor line is
      the low-risk kind, but these are load-bearing dependencies rather than
      optional ones, so they are worth re-testing against a running demo rather
      than trusting the unit suite alone.
    -->
    <tomcat.version>10.1.60</tomcat.version>
    <jackson-bom.version>2.21.7</jackson-bom.version>
    <log4j2.version>2.25.5</log4j2.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Redis storage is OPTIONAL: the adapter and its two classes are the only thing
      that needs these, and a host that stores DBSC state in its database should not
      inherit a Redis client. Optional dependencies are compile-visible here and are
      not pulled in transitively by consumers, which is exactly the shape wanted:
      dbsc.storage: redis fails at startup with a message naming the property rather
      than at class-load time somewhere unrelated.
    -->
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-redis</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.lettuce</groupId>
      <artifactId>lettuce-core</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Test-only, and never packaged: it exists so NonFormLoginChainTest can build a
      real oauth2Login() chain. The library itself has no OAuth2 dependency and
      must not grow one: DBSC is a servlet-layer concern that sits beside whatever
      authenticates the user.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Test-only: @WithMockUser, so the filter's authenticated-request path can be
      exercised without standing up a real login.
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Adds src/demo to the build and turns the library JAR into a runnable one.

        mvn -Pdemo -Dmaven.repo.local=.m2repo spring-boot:run

      To run over HTTPS you also need a keystore; see src/demo/resources/
      README-DEMO.md.
    -->
    <profile>
      <id>demo</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.1</version>
            <executions>
              <execution>
                <id>add-demo-source</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>add-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/demo/java</source>
                  </sources>
                </configuration>
              </execution>
              <execution>
                <id>add-demo-resources</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>add-resource</goal>
                </goals>
                <configuration>
                  <resources>
                    <resource>
                      <directory>src/demo/resources</directory>
                    </resource>
                    <!--
                      The Soft DBSC client lives at the repository root, not under
                      src/demo/resources/static. It is the artifact a deployer copies
                      into their own app, so it has to be findable without knowing
                      this build's layout, and it is not demo-specific: the wire
                      exchange it speaks is the library's, not the demo's. Including
                      the root here is what lets the demo serve its own copy.

                      Both files ship: the worker imports the client by absolute
                      path (/dbsc-soft-client.js), which is what a Service Worker
                      needs, because it has no document to resolve a relative import
                      against.
                    -->
                    <resource>
                      <directory>.</directory>
                      <includes>
                        <include>dbsc-soft-client.js</include>
                        <include>dbsc-soft-sw.js</include>
                      </includes>
                      <targetPath>static</targetPath>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <configuration>
              <skip>false</skip>
              <mainClass>click.yukio.dbsc.demo.DemoApplication</mainClass>
              <arguments>
                <!-- The demo's own config file, kept out of the way of the
                     library's defaults, which are also named application.yaml. -->
                <argument>--spring.profiles.active=demo${dbsc.demo.profiles}</argument>
              </arguments>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      A third demo instance running dbsc.unregistered=deny. The policy belongs to the
      server, so both outcomes cannot be observed against one process; this instance
      is the deny half of the comparison scripts/e2e.py makes.

        mvn -Pdemo,deny-e2e -Dmaven.repo.local=.m2repo spring-boot:run

      See src/demo/resources/application-deny-e2e.yaml.
    -->
    <profile>
      <id>deny-e2e</id>
      <properties>
        <dbsc.demo.profiles>,deny-e2e</dbsc.demo.profiles>
      </properties>
    </profile>

    <!--
      The demo on Redis instead of H2, so the store can be exercised end to end
      against a real server. Needs one on localhost:6379.

        mvn -Pdemo,redis-demo -Dmaven.repo.local=.m2repo spring-boot:run

      See src/demo/resources/application-redis-demo.yaml. This profile supplies the
      Redis client the library only declares as optional.
    -->
    <profile>
      <id>redis-demo</id>
      <properties>
        <dbsc.demo.profiles>,redis-demo</dbsc.demo.profiles>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
      </dependencies>
    </profile>

    <!--
      A fourth demo instance with a shortened rotation grace. Rotation itself is
      unconditional; what is per-instance is how long a retired session id keeps
      resolving, and the suite has to outwait that to prove the alias expires.

        mvn -Pdemo,rotation-e2e -Dmaven.repo.local=.m2repo spring-boot:run

      See src/demo/resources/application-rotation-e2e.yaml.
    -->
    <profile>
      <id>rotation-e2e</id>
      <properties>
        <dbsc.demo.profiles>,rotation-e2e</dbsc.demo.profiles>
      </properties>
    </profile>

    <!--
      A fifth demo instance with a shortened binding lifetime. A binding's deadline is
      stamped by bind() from the server's configuration, so a differently-configured
      process is the only way to observe it expiring at test speed, since the default is
      a day. The suite outwaits this to prove a refresh cannot renew a binding forever.

        mvn -Pdemo,ttl-e2e -Dmaven.repo.local=.m2repo spring-boot:run

      See src/demo/resources/application-ttl-e2e.yaml.
    -->
    <profile>
      <id>ttl-e2e</id>
      <properties>
        <dbsc.demo.profiles>,ttl-e2e</dbsc.demo.profiles>
      </properties>
    </profile>

    <!--
      The OIDC variant of the demo: adds an Entra ID login on top of src/demo and
      turns off the form-login chain (the two cannot coexist on one chain).

        ENTRA_CLIENT_SECRET=... mvn -Pdemo,oidc -Dmaven.repo.local=.m2repo spring-boot:run

      The oauth2 client starter is scoped to this profile and stays out of the
      published JAR: DBSC must not drag an OAuth2 dependency into the library.
    -->
    <profile>
      <id>oidc</id>
      <properties>
        <dbsc.demo.profiles>,oidc</dbsc.demo.profiles>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.1</version>
            <executions>
              <execution>
                <id>add-demo-oidc-source</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>add-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/demo/java-oidc</source>
                  </sources>
                </configuration>
              </execution>
              <execution>
                <id>add-demo-oidc-resources</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>add-resource</goal>
                </goals>
                <configuration>
                  <resources>
                    <resource>
                      <directory>src/demo/resources-oidc</directory>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Everything Maven Central requires, kept in a profile so the ordinary build
      stays fast and needs no signing key.

        mvn -s .m2settings/settings.xml -P release deploy

      Central rejects a deployment that is missing any of: a sources JAR, a javadoc
      JAR, a .asc signature for every file, or complete POM metadata (name,
      description, url, license, developers, scm) — the last of which is declared at
      the top level of this POM.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <!--
            Required: consumers expect to be able to read the source of what they
            depend on, and Central enforces it.
          -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <!--
                Not silent: a javadoc error fails the release. Central requires the
                JAR to exist, and a JAR full of complaints is worse than no JAR.
              -->
              <doclint>all,-missing</doclint>
              <quiet>true</quiet>
            </configuration>
          </plugin>

          <!--
            Every artifact must be GPG-signed. The key is selected by the usual
            gpg.defaultKeyring/gpg.keyname settings, or MAVEN_GPG_PASSPHRASE in CI.
          -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <!-- Pin the digest: the default SHA-1 signatures are deprecated. -->
              <keyarg>--digest-algo</keyarg>
              <keyarg-name>SHA512</keyarg-name>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </plugin>

          <!--
            Uploads a bundle of the whole deployment to the Central Portal, which
            validates it and then either publishes it or reports what is wrong. The
            "central" server id matches .m2settings/settings.xml.
          -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-maven-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!--
                Publishing is permanent and cannot be undone, so the default is to
                stop once Central has validated the deployment and let a human
                approve it in the Portal. The release workflow overrides this with
                -Dcentral.autoPublish=true when the operator asks for it.
              -->
              <autoPublish>${central.autoPublish}</autoPublish>
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
